{
    "app-id": "io.github.d3msudo.clamguard",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "clamguard",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.gtk.vfs",
        "--talk-name=org.gtk.vfs.mounttracker",
        "--talk-name=org.x.StatusNotifierWatcher",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.StatusNotifierWatcher",
        "--own-name=org.kde.StatusNotifierItem.*",
        "--filesystem=xdg-documents:ro",
        "--filesystem=xdg-download:ro",
        "--filesystem=xdg-config/clamav:ro",
        "--filesystem=xdg-data/clamav:ro",
        "--filesystem=/var/lib/clamav:ro",
        "--filesystem=/run/clamav:ro",
        "--filesystem=home/.cache/clamguard:rw",
        "--persist=.config/clamguard",
        "--persist=.local/share/clamguard",
        "--env=PYTHONPATH=/app/lib/python3.13/site-packages",
        "--env=CLAMAV_SOCKET=/run/clamav/clamd.ctl"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/aclocal",
        "*.la",
        "*.a"
    ],
    "modules": [
