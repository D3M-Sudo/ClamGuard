<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>ClamGuard</vendor>
  <vendor_url>https://github.com/D3M-Sudo/ClamGuard</vendor_url>
  <icon_name>io.github.d3msudo.clamguard</icon_name>

  <action id="io.github.d3msudo.clamguard.apply-signatures">
    <description>Install ClamGuard third-party virus signatures</description>
    <message>Authentication is required to install downloaded virus signatures into the system ClamAV database.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/clamguard-apply-signatures</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
